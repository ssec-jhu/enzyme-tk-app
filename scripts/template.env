# EnzymeTK — local environment secrets (gitignored, never commit this file)
#
# This file is generated by scripts/generate-env.sh. To regenerate it (e.g. to
# rotate the secrets), re-run that script. The two secrets below are filled in
# automatically with fresh random values. To produce equivalents by hand:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # ETK_ADMIN_TOKEN
#   python3 -c "import secrets; print(secrets.token_hex(32))"       # ETK_SECRET_KEY

# Token required to log in to the hidden /admin dashboard.
# Read once at startup into the application config and only checked at the
# moment the user logs in.
ETK_ADMIN_TOKEN=__ETK_ADMIN_TOKEN__

# Flask secret key used to sign the admin session cookie. This is the
# logged-in state: after a successful login the is_admin cookie is set and
# signed with this secret key, so it stays valid across container rebuilds.
ETK_SECRET_KEY=__ETK_SECRET_KEY__
