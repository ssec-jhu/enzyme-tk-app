# EnzymeTK — local environment secrets (gitignored, never commit this file)
#
# This file is generated by scripts/generate-env.sh. To regenerate it (e.g. to
# rotate the secrets), re-run that script. 
#
# Host-only: nothing inside the Docker image reads this file. .dockerignore
# excludes .env and .env.* from the build context so `COPY . .` cannot bake these
# values into a published image layer, and docker compose does its ${VAR}
# substitution here on the host before the containers start.
#
# Token required to log in to the hidden /admin dashboard.
# Read once at startup into the application config and only checked at the
# moment the user logs in.
ETK_ADMIN_TOKEN=__ETK_ADMIN_TOKEN__

# Flask secret key used to sign the admin session cookie. This is the
# logged-in state: after a successful login the is_admin flask session 
# is set and signed with this secret key, so it stays valid across 
# container rebuilds.
#
# It also seeds the submission captcha's signing key (derived, domain-separated,
# so the two uses never share key material) — which is why it is REQUIRED, admin
# dashboard or not, whenever APP_IN_PRODUCTION_MODE is on: the app refuses to
# start without it. Rotating it logs admins out and invalidates captcha
# challenges in flight, which costs a user one retry.
ETK_SECRET_KEY=__ETK_SECRET_KEY__

# Sliding idle window for an unlocked admin session, in seconds (default 300).
# Every authenticated check slides it forward, including the dashboard's 10 s
# poll, so an open tab never expires; close it and access lapses after this
# window. Uncomment to override.
# ETK_ADMIN_SESSION_TTL_SECONDS=300

# ── Production switch ────────────────────────────────────────────────────────
# Default OFF: a downloaded checkout runs locally with no submission limits and
# no captcha. Set this to true for a public deployment. It is the single lever,
# and it switches on TWO protections on job submission:
#   * the per-session cap on concurrent jobs, which stops one browser starving
#     the Celery workers (enzyme_tk_app/app/utils/submission_limits.py), and
#   * a proof-of-work captcha on every Run click, bound to the session so that
#     discarding the session cookie costs a solve (enzyme_tk_app/app/utils/captcha.py).
# Neither one's policy is an environment variable — the cap, and the captcha's
# cost and TTL, are constants in those modules. Turning this on REQUIRES
# ETK_SECRET_KEY above; the app refuses to start otherwise.
# (The Azure deployment in main.bicep hardcodes this on, so this line only
# affects docker compose.)
#
# generate-env.sh --production uncomments this for you, and a later plain
# rerun to rotate the secrets preserves whatever the existing .env had — so a
# rotation never silently drops a live deployment back to local defaults.
# APP_IN_PRODUCTION_MODE=true
