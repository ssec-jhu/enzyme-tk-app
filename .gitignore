# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# VS Code
.vscode

# File system
.DS_Store

# Leftover from before scripts/db_build/ wrote into the app data directory: neither script
# creates output/ any more, but an existing one still holds gigabytes of model weights that
# `git add -A` would otherwise stage. The glob also catches Finder-style duplicates
# ("output copy"). Safe to drop once you have moved or deleted yours.
/scripts/db_build/output*/
# App data: large downloaded/generated sets — ignore all except the sample structures/
# (this also covers .hf_cache/, where download_data.py puts the ESM3 snapshot)
/enzyme_tk_app/app/data/*
!/enzyme_tk_app/app/data/structures/

# .claude/ is local tooling (GSD, settings, worktrees); track only the project
# agent sources and skills — AGENTS.md documents both as project conventions, so
# a clone without them would follow instructions pointing at files it doesn't have.
/.claude/*
!/.claude/agents/
/.claude/agents/gsd-*.md
!/.claude/skills/

# .planning/ is GSD's local working directory (roadmaps, codebase maps, reviews) — regenerated, not shared
/.planning/

# graphify's scratch output — the knowledge graph build copies from here into .planning/graphs/
/graphify-out/
